# MONITOR-THREAT environment variables
# Copy this file to .env and fill in real values.

# Database (SQLite, default)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# IP Intel — VirusTotal v3 (free tier: 4 req/min, 500/day)
# Get a key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# IP Intel — AbuseIPDB (optional, free tier: 1000 checks/day)
# Get a key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
